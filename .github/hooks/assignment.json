{
  "version": 1,
  "hooks": {
    "SessionStart": [
      { "type": "command", "command": "node .github/hooks/ai-log.cjs SessionStart", "timeoutSec": 10 }
    ],
    "UserPromptSubmit": [
      { "type": "command", "command": "node .github/hooks/ai-log.cjs UserPromptSubmit", "timeoutSec": 10 }
    ],
    "PostToolUse": [
      { "type": "command", "command": "node .github/hooks/ai-log.cjs PostToolUse", "timeoutSec": 10 }
    ],
    "SubagentStart": [
      { "type": "command", "command": "node .github/hooks/ai-log.cjs SubagentStart", "timeoutSec": 10 }
    ],
    "SubagentStop": [
      { "type": "command", "command": "node .github/hooks/check-review-format.cjs", "timeoutSec": 10 },
      { "type": "command", "command": "node .github/hooks/ai-log.cjs SubagentStop", "timeoutSec": 10 }
    ],
    "Stop": [
      { "type": "command", "command": "node .github/hooks/ai-log.cjs Stop", "timeoutSec": 10 }
    ]
  }
}
